{
  "name": "beau-banana",
  "version": "1.0.0",
  "description": "Beau Banana Shopify Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:products": "node scripts/build-product-pages.js",
    "build:policies": "node scripts/build-policy-pages.js",
    "update:config": "node update-config.js",
    "build:includes": "node scripts/include-common-elements.js",
    "build:homepage": "node scripts/build-homepage.js",
    "build": "npm run update:config && npm run build:includes && npm run build:products && npm run build:policies && npm run build:homepage && npm run build:includes && npm run prepare:site",
    "prepare:site": "node scripts/prepare-site.js",
    "test": "node --test tests/*.test.cjs"
  },
  "keywords": [
    "shopify",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "glob": "^14.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
