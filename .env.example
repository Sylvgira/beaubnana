# Optional for local development: without credentials the saved snapshot is used.
# Set both values to build fresh Shopify product and policy pages.
SHOPIFY_STORE_NAME=
SHOPIFY_STOREFRONT_TOKEN=
# Optional separate public Buy Button token; otherwise uses the Storefront token.
SHOPIFY_BUY_SDK_TOKEN=
# live or snapshot; omit to choose live when credentials are configured.
SHOPIFY_DATA_SOURCE=
# For a future domain-root host, set BASE_PATH=/ and SITE_URL to that origin.
BASE_PATH=/beaubnana
SITE_URL=https://sylvgira.github.io
