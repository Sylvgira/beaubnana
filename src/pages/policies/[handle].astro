---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getShopData, type Policy } from '../../lib/shopify';
export async function getStaticPaths() {
  const { policies } = await getShopData();
  return policies.map(policy => ({params:{handle:policy.handle},props:{policy}}));
}
interface Props { policy: Policy }
const { policy } = Astro.props;
---
<SiteLayout title={`${policy.title} | Beaubnana`} description={`${policy.title} for Beaubnana.`}>
  <section><div class="padding-global padding-section-medium"><div class="container-large">
    <h1 class="heading-style-h2">{policy.title}</h1>
  </div></div></section>
  <section><div class="padding-global padding-section-medium"><div class="container-large">
    <div class="text-rich-text w-richtext" set:html={policy.body} />
  </div></div></section>
</SiteLayout>
